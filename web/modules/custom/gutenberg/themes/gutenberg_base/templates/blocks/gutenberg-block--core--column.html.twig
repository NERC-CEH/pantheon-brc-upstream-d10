{#
/**
 * @file
 * Template for the core/column block.
 *
 * Available variables:
 *   - attributes: HTML attributes for the wrapper element (class, style, id…).
 *   - inner_content: Rendered inner blocks (without the block's own wrapper).
 *   - block_content: Full serialized block HTML including the block's wrapper.
 *   - block_name: The block name ('core/column').
 *   - block_attributes: Raw block attributes array from the editor.
 */
#}
<div {{ attributes }}>{{ inner_content }}</div>
