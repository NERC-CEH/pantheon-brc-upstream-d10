    "@wordpress/patterns": "2.55.0",
    "@wordpress/plugins": "7.55.0",
    "@wordpress/preferences": "4.55.0",
    "@wordpress/preferences-persistence": "2.55.0",
    "@wordpress/primitives": "4.55.0",
    "@wordpress/priority-queue": "3.55.0",
    "@wordpress/private-apis": "1.55.0",
    "@wordpress/redux-routine": "5.55.0",
    "@wordpress/reusable-blocks": "6.0.0",
    "@wordpress/rich-text": "7.55.0",
    "@wordpress/router": "1.55.0",
    "@wordpress/server-side-render": "6.31.0",
    "@wordpress/shortcode": "4.55.0",
    "@wordpress/style-engine": "2.55.0",
    "@wordpress/sync": "1.55.0",
    "@wordpress/theme": "2.1.0",
    "@wordpress/token-list": "3.55.0",
    "@wordpress/undo-manager": "1.55.0",
    "@wordpress/upload-media": "0.40.0",
    "@wordpress/url": "4.55.0",
    "@wordpress/viewport": "6.55.0",
