    "lodash": "4.17.21",
    "moment": "2.29.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "regenerator-runtime": "0.14.1",
    "sprintf-js": "1.1.3"
  },
  "devDependencies": {
    "@drupal/playwright": "1.2.0",
    "@playwright/test": "1.63.0",
    "@wordpress/dependency-extraction-webpack-plugin": "6.55.0",
    "@wordpress/eslint-plugin": "^26.0.0",
    "@wordpress/scripts": "^35.0.0",
    "chalk": "^4.1.2",
    "copy-webpack-plugin": "^11.0.0",
    "cssnano": "^6.0.0",
    "fs-extra": "^11.2.0",
    "glob": "^10.3.10",
    "globals": "16.5.0",
    "minimist": "^1.2.8",
    "patch-package": "^8.0.1",
    "postcss": "^8.4.0",
    "sass": "^1.69.5",
    "typescript": "^5.4.5",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  }
}
