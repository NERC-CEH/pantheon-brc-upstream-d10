{
  "name": "drupal-gutenberg",
  "description": "Drupal is an open source content management platform powering millions of websites and applications.",
  "license": "GPL-2.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build:vendor": "webpack --config webpack.vendor.config.js && node scripts/copy-block-assets.js && webpack --config webpack.view-scripts.config.js && php scripts/gutenberg-dependencies.php && php scripts/write-gutenberg-version.php",
    "build:vendor-dev": "webpack --config webpack.vendor.config.js --mode development && node scripts/copy-block-assets.js && webpack --config webpack.view-scripts.config.js --mode development && php scripts/gutenberg-dependencies.php && php scripts/write-gutenberg-version.php",
    "build": "wp-scripts build && npm run translations",
    "start": "wp-scripts start",
    "dev": "npm run build && npm start",
    "translations": "node ./packages/drupal-gutenberg-translations/index.js ./packages ./packages && mv ./packages/drupal-gutenberg-translations.js ./js/drupal-gutenberg-translations.js",
    "lint:js": "wp-scripts lint-js packages/ tests/ eslint.config.mjs playwright.config.mjs",
    "lint:css": "wp-scripts lint-style 'css/**/*.scss' 'packages/**/*.scss' 'modules/**/*.{css,scss}' 'themes/**/*.{css,scss}' 'tests/**/*.css'",
    "release": "npm run build:vendor && npm run build",
    "postinstall": "patch-package",
    "update-wp-packages": "node scripts/update-wp-packages.js",
    "sync-style-engine": "node scripts/sync-style-engine.js",
    "sync-block-supports": "node scripts/sync-block-supports.js",
    "test:playwright": "playwright test"
  },
  "dependencies": {
    "@wordpress/a11y": "4.55.0",
    "@wordpress/annotations": "3.55.0",
    "@wordpress/api-fetch": "7.55.0",
    "@wordpress/autop": "4.55.0",
    "@wordpress/blob": "4.55.0",
    "@wordpress/block-directory": "5.55.0",
    "@wordpress/block-editor": "17.1.0",
    "@wordpress/block-library": "11.0.0",
    "@wordpress/block-serialization-default-parser": "5.55.0",
    "@wordpress/block-serialization-spec-parser": "5.55.0",
    "@wordpress/blocks": "16.0.0",
    "@wordpress/commands": "1.55.0",
    "@wordpress/components": "40.1.0",
    "@wordpress/compose": "8.8.0",
    "@wordpress/core-commands": "1.55.0",
    "@wordpress/core-data": "8.0.0",
    "@wordpress/data": "10.55.0",
    "@wordpress/data-controls": "4.55.0",
    "@wordpress/date": "5.55.0",
    "@wordpress/deprecated": "4.55.0",
    "@wordpress/dom": "4.55.0",
    "@wordpress/dom-ready": "4.55.0",
    "@wordpress/edit-post": "8.55.0",
    "@wordpress/editor": "15.0.0",
    "@wordpress/element": "8.7.0",
    "@wordpress/escape-html": "3.55.0",
    "@wordpress/format-library": "5.55.0",
    "@wordpress/global-styles-engine": "1.22.0",
    "@wordpress/global-styles-ui": "1.22.0",
    "@wordpress/hooks": "4.55.0",
    "@wordpress/html-entities": "4.55.0",
    "@wordpress/i18n": "6.28.0",
    "@wordpress/icons": "16.0.0",
    "@wordpress/image-cropper": "1.19.0",
    "@wordpress/interface": "10.1.0",
    "@wordpress/is-shallow-equal": "5.55.0",
    "@wordpress/keyboard-shortcuts": "5.55.0",
    "@wordpress/keycodes": "4.55.0",
    "@wordpress/latex-to-mathml": "1.23.0",
    "@wordpress/list-reusable-blocks": "5.55.0",
    "@wordpress/media-editor": "0.18.0",
    "@wordpress/media-fields": "0.20.0",
