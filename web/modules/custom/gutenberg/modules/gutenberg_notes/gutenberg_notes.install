<?php

/**
 * @file
 * Install, update, and uninstall functions for the Gutenberg Notes module.
 */

use Drupal\field\Entity\FieldStorageConfig;

/**
 * Implements hook_install().
 */
function gutenberg_notes_install() {
  // Add the comment_body field to the gutenberg_note comment type.
  \Drupal::service('comment.manager')->addBodyField('gutenberg_note');

  // Create the field storage for the gutenberg_notes comment field on nodes.
  _gutenberg_notes_ensure_field_storage();

  // Add the comment field to all Gutenberg-enabled node types.
  $config = \Drupal::config('gutenberg.settings');
  $node_types = \Drupal::entityTypeManager()
    ->getStorage('node_type')
    ->loadMultiple();

  foreach ($node_types as $node_type) {
    $bundle = $node_type->id();
    if ($config->get($bundle . '_enable_full')) {
      _gutenberg_notes_ensure_field_instance($bundle);
    }
  }
}

/**
 * Implements hook_uninstall().
 */
function gutenberg_notes_uninstall() {
  $entity_type_manager = \Drupal::entityTypeManager();

  // Delete all gutenberg_note comment entities.
  $comment_storage = $entity_type_manager->getStorage('comment');
  $cids = $comment_storage->getQuery()
    ->condition('comment_type', 'gutenberg_note')
    ->accessCheck(FALSE)
    ->execute();

  if (!empty($cids)) {
    $comments = $comment_storage->loadMultiple($cids);
    $comment_storage->delete($comments);
  }

  // Delete all gutenberg_notes field instances on node bundles.
  $field_configs = $entity_type_manager
    ->getStorage('field_config')
    ->loadByProperties([
      'entity_type' => 'node',
      'field_name' => 'gutenberg_notes',
    ]);

  foreach ($field_configs as $field_config) {
    $field_config->delete();
  }

  // Delete the gutenberg_notes field storage on nodes.
  $field_storage = FieldStorageConfig::loadByName('node', 'gutenberg_notes');
  if ($field_storage) {
    $field_storage->delete();
  }

  // Delete the comment_body field on the gutenberg_note comment type
  // (created by comment.manager->addBodyField() during install).
  $body_field = $entity_type_manager
    ->getStorage('field_config')
    ->load('comment.gutenberg_note.comment_body');
  if ($body_field) {
    $body_field->delete();
  }

  // Delete the gutenberg_note comment type itself.
  $comment_type = $entity_type_manager
    ->getStorage('comment_type')
    ->load('gutenberg_note');
  if ($comment_type) {
    $comment_type->delete();
  }
}
